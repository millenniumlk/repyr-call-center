# Server
PORT=3001
NODE_ENV=development

# CORS - set to your frontend URL
FRONTEND_URL=http://localhost:5173

# Base URL used to generate customer call links
# In production: https://app.repyr.com
BASE_CALL_URL=http://localhost:5173

# ─── WhatsApp Web (whatsapp-web.js) ──────────────────────────────────────────
# Set to true to skip WhatsApp entirely during development (shows URL in terminal)
MOCK_WHATSAPP=false

# Where to save the WhatsApp session (so you only scan QR once)
WA_SESSION_PATH=./.wwebjs_auth

# Legacy Meta Cloud API fields (not used with whatsapp-web.js — leave blank)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=repyr_call_invite
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ─── WebRTC ICE / STUN / TURN ────────────────────────────────────────────
# STUN server (default: Google public STUN)
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# TURN server (leave blank to disable TURN in dev)
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
