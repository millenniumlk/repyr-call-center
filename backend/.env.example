# Server
PORT=3001
NODE_ENV=development

# CORS - set to your frontend URL
FRONTEND_URL=http://localhost:5173

# Base URL used to generate customer call links
# In production: https://app.repyr.com
BASE_CALL_URL=http://localhost:5173

# ─── WhatsApp Web (whatsapp-web.js) ──────────────────────────────────────────
# ─── Notify.lk SMS API ──────────────────────────────────────────────────────────
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# Set to true to skip actual SMS calls during development and just print to terminal
MOCK_SMS=true

# ─── WebRTC ICE / STUN / TURN ────────────────────────────────────────────
# STUN server (default: Google public STUN)
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# TURN server (leave blank to disable TURN in dev)
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
